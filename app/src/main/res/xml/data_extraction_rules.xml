<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the library database (favorites, playlists, saved albums) and settings
     travel with backups and device transfers. The YouTube sign-in does not: it is encrypted
     with a key that never leaves this device, so a copy would be useless anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vyora_account.xml" />
        <exclude domain="sharedpref" path="vyora_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vyora_account.xml" />
        <exclude domain="sharedpref" path="vyora_sync.xml" />
    </device-transfer>
</data-extraction-rules>
